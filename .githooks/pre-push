#!/usr/bin/env bash
# pre-push: refuse to push if ANY commit in the pushed range was not authored
# AND committed by the QuantumindSSI account. This catches commits created
# outside this machine (e.g. cherry-picked, merged, or made before the hook
# was installed) that would otherwise land on origin.
#
# git passes: <local_ref> <local_sha> <remote_ref> <remote_sha> on stdin,
# and the remote name/URL as $1/$2.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=allowed-identity.sh
. "$HOOK_DIR/allowed-identity.sh"

ZERO="0000000000000000000000000000000000000000"
violations=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote ref: nothing to inspect.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: inspect every commit reachable from local_sha
    # that isn't already on any other remote branch.
    range="$local_sha --not --remotes=origin"
  else
    range="$remote_sha..$local_sha"
  fi

  # For each commit, print "author_email|author_name|committer_email".
  while IFS='|' read -r a_email a_name c_email; do
    [ -z "$a_email" ] && continue
    if ! identity_email_allowed "$a_email" \
       || ! identity_email_allowed "$c_email" \
       || [ "$a_name" != "$ALLOWED_NAME" ]; then
      commit_sha="$(git log -1 --format='%h' --all --grep='' 2>/dev/null || true)"
      echo "✗ push blocked: a commit is not authored by the QuantumindSSI account:" >&2
      echo "    author:    $a_name <$a_email>" >&2
      echo "    committer: <$c_email>" >&2
      violations=$((violations + 1))
    fi
  done < <(git log --format='%ae|%an|%ce' $range 2>/dev/null || true)
done

if [ "$violations" -ne 0 ]; then
  echo "" >&2
  echo "This repository requires every pushed commit to be made by QuantumindSSI." >&2
  echo "Rewrite the offending commits' identity (e.g. git rebase -x or" >&2
  echo "git filter-repo --mailmap) so they are authored by:" >&2
  print_allowed >&2
  exit 1
fi

exit 0
