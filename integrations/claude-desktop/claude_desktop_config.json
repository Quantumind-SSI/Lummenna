{
  "mcpServers": {
    "lummenna": {
      "command": "python",
      "args": ["-m", "lummenna.integrations.mcp_server"],
      "env": {
        "LUMENA_DEVICE": "generic",
        "LUMENA_STORE_PATH": "${userHome}/.lumena/store",
