{
  "mcpServers": {
    "lummenna": {
      "command": "python",
      "args": ["-m", "lummenna.integrations.mcp_server"],
      "env": {
        "LUMMENNA_DEVICE": "generic",
        "LUMMENNA_STORE_PATH": "${userHome}/.lummenna/store",
        "LUMMENNA_MODEL_PATH": "${userHome}/.lummenna/models"
      }
    }
  }
}
