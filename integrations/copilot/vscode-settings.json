{
  "github.copilot.chat.mcp.servers": [
    {
      "name": "lumena",
      "command": "python",
      "args": ["-m", "lumena.integrations.mcp_server"],
      "env": {
        "LUMENA_DEVICE": "generic",
        "LUMENA_STORE_PATH": "${userHome}/.lumena/store",
        "LUMENA_MODEL_PATH": "${userHome}/.lumena/models"
      }
    }
  ]
}
