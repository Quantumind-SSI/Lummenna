{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lumena": {
      "type": "local",
      "command": ["python3", "-m", "lumena.integrations.mcp_server"],
      "enabled": true,
      "environment": {
        "LUMENA_DEVICE": "generic",
        "LUMENA_STORE_PATH": "./.lumena/store",
        "LUMENA_MODEL_PATH": "./.lumena/models",
        "LUMENA_AUTO_PROVISION_MODEL": "1"
      }
    }
  }
}
