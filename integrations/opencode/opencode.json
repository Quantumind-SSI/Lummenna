{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lummenna": {
      "type": "local",
      "command": ["lummenna", "mcp"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "LUMMENNA_DEVICE": "generic",
        "LUMMENNA_STORE_PATH": "./.lummenna/store",
        "LUMMENNA_MODEL_PATH": "./.lummenna/models",
        "LUMMENNA_AUTO_PROVISION_MODEL": "1"
      }
    }
  }
}
