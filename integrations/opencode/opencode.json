{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "lumena-memory": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "lumena.integrations.mcp_server"
      ],
      "enabled": true,
      "env": {
        "LUMENA_DEVICE": "generic",
        "LUMENA_STORE_PATH": "./.lumena/store",
        "LUMENA_MODEL_PATH": "./.lumena/models"
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/skills/lumena-memory/SKILL.md"
  ]
}
